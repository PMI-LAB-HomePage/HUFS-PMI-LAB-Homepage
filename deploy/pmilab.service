# /etc/systemd/system/pmilab.service 로 복사 → systemctl enable --now pmilab
[Unit]
Description=PMI Lab homepage (gunicorn)
After=network.target

[Service]
User=pmilab
Group=pmilab
WorkingDirectory=/srv/pmilab/app
ExecStart=/srv/pmilab/venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8000 --workers 3
Restart=always

[Install]
WantedBy=multi-user.target
