# compose가 /etc/caddy/Caddyfile로 읽기 전용 마운트한다. 고친 뒤 `docker compose restart caddy`.
# 인증서는 Caddy가 자동 발급·갱신한다 (80·443이 모두 열려 있어야 한다).
pmi.hufs.ac.kr {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}
	handle {
		reverse_proxy web:8000
	}
}
