# /etc/caddy/Caddyfile 로 복사. 인증서는 Caddy가 자동 발급·갱신 (80·443 모두 열려 있어야 함)
pmi.hufs.ac.kr {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/pmilab/app/staticfiles
		file_server
	}
	handle_path /media/* {
		root * /srv/pmilab/app/media
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
