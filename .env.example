# 로컬 개발용 기본값. 서버에서는 SECRET_KEY 새로 생성, DEBUG=0, ALLOWED_HOSTS=pmi.hufs.ac.kr
# SECRET_KEY 생성: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# 아래 세 개는 건드리지 않는다. Docker에서는 compose.yaml이 넣어 준다.
# 비어 있으면 저장소 폴더 안(db.sqlite3 · media/ · staticfiles/)을 쓴다 — 로컬 개발용.
# SQLITE_PATH=/data/db.sqlite3
# MEDIA_ROOT=/data/media
# STATIC_ROOT=
